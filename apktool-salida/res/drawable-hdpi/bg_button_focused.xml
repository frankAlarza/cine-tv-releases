<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_window_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#6366f1" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4f46e5" />
            <stroke android:width="4.0dp" android:color="#93c5fd" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#818cf8" />
            <stroke android:width="4.0dp" android:color="#bfdbfe" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#818cf8" />
            <stroke android:width="4.0dp" android:color="#bfdbfe" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6366f1" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
