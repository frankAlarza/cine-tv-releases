<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <layer-list>
            <item android:drawable="@drawable/tab_background_checked" />
            <item android:drawable="@drawable/bg_focused" />
        </layer-list>
    </item>
    <item android:state_focused="true" android:state_selected="false">
        <layer-list>
            <item android:drawable="@drawable/tab_background_unchecked" />
            <item android:drawable="@drawable/bg_focused" />
        </layer-list>
    </item>
    <item android:state_selected="false" android:drawable="@drawable/tab_background_unchecked" />
    <item android:state_selected="true" android:drawable="@drawable/tab_background_checked" />
</selector>
