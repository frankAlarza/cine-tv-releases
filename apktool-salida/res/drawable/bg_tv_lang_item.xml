<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de idioma (glass/dark): fondo glass para todos los estados, sin colores de marca.
     El halo de foco lo dibuja tv_modal_focus (foreground). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>