<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1affffff" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1.0dp" android:color="#33ffffff" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1.0dp" android:color="#66ffffff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14ffffff" />
            <corners android:radius="@dimen/tv_lang_item_radius" />
            <stroke android:width="1.0dp" android:color="#1affffff" />
        </shape>
    </item>
</selector>
