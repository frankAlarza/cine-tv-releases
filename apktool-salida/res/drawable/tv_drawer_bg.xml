<?xml version="1.0" encoding="utf-8"?>
<!-- Panel del cajon de secciones — estilo Apple TV: superficie oscura, esquinas
     izquierdas redondeadas, borde sutil. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tv_color_surface" />
    <corners
        android:topLeftRadius="@dimen/tv_radius_lg"
        android:bottomLeftRadius="@dimen/tv_radius_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/tv_color_divider" />
</shape>